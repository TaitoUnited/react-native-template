{
  "outDir": "src/design-system",
  "tokenize": {
    "tokens": [
      {
        "name": "colors",
        "type": "color"
      },
      {
        "name": "typography",
        "type": "text"
      },
      {
        "name": "shadows",
        "type": "drop-shadow"
      },
      {
        "name": "spacing",
        "type": "width",
        "nodeName": "Figmage - Spacing"
      },
      {
        "name": "radii",
        "type": "radius",
        "nodeName": "Figmage - Radii"
      },
      {
        "name": "icons",
        "type": "svg",
        "nodeName": "Figmage - Icons"
      },
      {
        "name": "assets",
        "type": "png",
        "nodeName": "App Icon & Splash"
      }
    ]
  },
  "codegen": {
    "defaults": {
      "filetype": "ts",
      "tokenCase": "camel"
    },
    "spacing": {
      "filetype": "json",
      "tokenCase": "lower"
    },
    "assets": {
      "filetype": "png",
      "tokenCase": "kebab"
    }
  }
}
